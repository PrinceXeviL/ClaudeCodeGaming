<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 19 Eki: izleme yok, reklam kimliği yok, hesap yok. GameAnalytics anahtarı bağlanınca NSPrivacyCollectedDataTypes'a
	     "Product Interaction" + "Other Diagnostic Data" (bağlı değil, izleme değil, amaç Analytics) eklenecek. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- @capacitor/preferences kayıtları UserDefaults'ta tutar (eklentinin kendi gizlilik dosyası yok) -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
